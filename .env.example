# Variables de entorno de Vigía (todas las que leen src/lib/config.ts y src/lib/public-config.ts).
#
# Copia este archivo a .env.local para desarrollo. Tal como está (todo vacío) la app
# corre en MODO LOCAL sin credenciales:
#   - sin DATABASE_URL      → datos en .data/db.json y acceso abierto (sesión demo)
#   - sin GCS_BUCKET        → videos y fotogramas en .data/files
#   - sin ANTHROPIC_API_KEY → sin análisis de IA (la interfaz muestra «Sin IA»)
# Una variable vacía equivale a no definirla: se usa el valor por defecto indicado.
#
# En Cloud Run, deploy/cloudrun.sh define las variables y monta los secretos; no se
# usa este archivo. Nunca subas un .env con valores reales al repositorio.

# ---------------------------------------------------------------------------
# Base de datos (Postgres / Cloud SQL)
# ---------------------------------------------------------------------------
# Cadena de conexión. Definirla activa Postgres y el inicio de sesión del personal.
# Obligatoria en producción. Ejemplos:
#   local (Docker): postgresql://postgres:vigia@localhost:5432/vigia
#   Cloud Run:      postgresql://USUARIO:CLAVE@/BASE?host=/cloudsql/PROYECTO:REGION:INSTANCIA
#                   (la clave va codificada para URL)
DATABASE_URL=
# 1 → conexión con SSL (Postgres administrado por IP). No hace falta con el socket de Cloud SQL.
DATABASE_SSL=
# Máximo de conexiones por instancia (por defecto 8). Instancias × este valor debe
# quedar bajo el límite de conexiones de la base (db-g1-small ≈ 50).
DATABASE_POOL_MAX=
# 0 → no aplicar migraciones automáticamente al primer uso (por defecto se aplican,
# con candado de Postgres). Para aplicarlas a mano: npx tsx scripts/db-migrate.mts
VIGIA_AUTO_MIGRATE=
# Solo para las pruebas del store contra Postgres (src/lib/store/postgres.test.ts).
# Usa una base desechable: las pruebas borran datos.
# TEST_DATABASE_URL=postgresql://postgres:vigia@localhost:55432/postgres

# ---------------------------------------------------------------------------
# Personal (obligatorias si hay DATABASE_URL)
# ---------------------------------------------------------------------------
# Secreto para firmar la cookie de sesión. Genera uno con: openssl rand -base64 48
# OJO, demo: el login es una maqueta (src/lib/auth.ts). Sin este secreto no hay error:
# no se emite cookie y /mando abre sin pasar por la pantalla de login.
VIGIA_SESSION_SECRET=
# Cuenta administradora inicial: si ese correo no existe, se crea como admin en el
# primer inicio de sesión con estas credenciales. Clave de al menos 10 caracteres.
VIGIA_ADMIN_EMAIL=admin@vigia.local
VIGIA_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Archivos (Cloud Storage)
# ---------------------------------------------------------------------------
# Bucket para videos y fotogramas (subida directa con URL firmada V4). Vacío → .data/files.
# Fuera de Cloud Run necesitas credenciales de Google con permiso para firmar
# (gcloud auth application-default login, o GOOGLE_APPLICATION_CREDENTIALS con una
# llave de cuenta de servicio) y CORS en el bucket para el origen local.
GCS_BUCKET=
# Proyecto de Google Cloud. Opcional: en Cloud Run se detecta solo. GCP_PROJECT es un alias.
GOOGLE_CLOUD_PROJECT=
GCP_PROJECT=

# ---------------------------------------------------------------------------
# Inteligencia artificial (Claude)
# ---------------------------------------------------------------------------
# Llave de la API de Anthropic. Sin ella (y sin ANTHROPIC_AUTH_TOKEN) no hay análisis de IA.
ANTHROPIC_API_KEY=
# Alternativa a la llave: token de autorización (Bearer).
ANTHROPIC_AUTH_TOKEN=
# Modelo para todos los análisis (por defecto claude-opus-5-5).
VIGIA_AI_MODEL=
# Esfuerzo de razonamiento: low | medium | high | xhigh | max (por defecto medium:
# en una emergencia importa la latencia).
VIGIA_AI_EFFORT=
# 1 → modo rápido (más tokens por segundo, mayor precio).
VIGIA_AI_FAST=
# Observador del video en vivo del dron (una mirada cada 15 s).
# Por defecto claude-opus-5-5, esfuerzo low y modo rápido (~2,2 s por mirada, ~US$4 por hora de vuelo).
VIGIA_AI_LIVE_MODEL=
VIGIA_AI_LIVE_EFFORT=
# 0 → apaga el modo rápido del observador (solo existe en Opus; con otro modelo se ignora).
VIGIA_AI_LIVE_FAST=
# Detector de objetos YOLO local (vigia/detector, ver su README), p. ej. http://127.0.0.1:8765.
# Con él, cada fotograma (videos de vecinos y video en vivo del dron) pasa primero por YOLO y
# Claude razona sobre las detecciones en texto más UN cuadro anotado: más rápido y barato.
# El video en vivo del dron dibuja las cajas. Vacío o caído → Claude con visión, como antes.
VIGIA_DETECTOR_URL=
# gcp → el detector es un Cloud Run privado (deploy/detector.sh) y se llama con token de identidad.
VIGIA_DETECTOR_AUTH=
# Reconstrucción 3D en vivo (servicio vigia-live3d con GPU, ver gpu/splat/LIVE3D.md), p. ej.
# http://127.0.0.1:8790. Con él, los cuadros del video en vivo del dron se reenvían (hasta ~4 por
# segundo) y el puesto de mando muestra la nube de puntos creciendo. Vacío → sin vista 3D en vivo.
VIGIA_LIVE3D_URL=
# gcp → el servicio es un Cloud Run privado y se llama con token de identidad.
VIGIA_LIVE3D_AUTH=

# ---------------------------------------------------------------------------
# Agente Vigía (src/lib/vigia): escucha continua de las emergencias activas
# ---------------------------------------------------------------------------
# 0 → apaga la escucha continua (por defecto encendida). Sin llave de Anthropic responde
# con plantillas fijas, rotuladas "sin IA" en la mesa de mando.
VIGIA_AGENT=
# Modelo del agente (por defecto claude-opus-5-5), esfuerzo (por defecto low) y modo
# rápido (por defecto encendido; VIGIA_AGENT_FAST=0 lo apaga). Responde en ~5 a 8 s.
VIGIA_AGENT_MODEL=
VIGIA_AGENT_EFFORT=
VIGIA_AGENT_FAST=
# Segundos sin confirmación tras los que Vigía recuerda un pedido de radio (por defecto 180).
VIGIA_PENDING_REMIND_S=

# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------
# Ejecutable de ffmpeg para extraer fotogramas en el servidor (por defecto "ffmpeg"
# del PATH; la imagen Docker usa /usr/bin/ffmpeg).
FFMPEG_PATH=
# Secreto HMAC para firmar subidas en modo local y tokens internos. Si falta se usa
# VIGIA_SESSION_SECRET, y si también falta, un valor fijo SOLO apto para desarrollo.
VIGIA_FILE_SECRET=
# Carpeta de datos del modo local (por defecto .data). En Cloud Run el disco es
# efímero: el modo local allí solo sirve para demos.
VIGIA_DATA_DIR=

# ---------------------------------------------------------------------------
# Zello: la única vía de voz con los bomberos (puente aparte: npm run zello)
# ---------------------------------------------------------------------------
# El puente (tools/zello-bridge) corre en el notebook o en la Jetson, escucha el canal
# y registra cada transmisión en la bitácora de las emergencias abiertas; Vigía habla
# en el mismo canal. Sin estas variables el puente no arranca y la app sigue igual.
#
# Cuenta de Zello del bot de Vigía: el *username* de Zello (no el correo) y su clave.
ZELLO_USERNAME=
ZELLO_PASSWORD=
# Zello gratis (zello.io) exige un token en el logon. Dos opciones de developers.zello.com:
#  - ZELLO_AUTH_TOKEN: el "Sample Development Token" (dura 30 días), o
#  - ZELLO_ISSUER + ZELLO_PRIVATE_KEY: el puente firma un JWT RS256 en cada conexión.
#    La llave PEM va en una línea, con los saltos como \n.
ZELLO_AUTH_TOKEN=
ZELLO_ISSUER=
ZELLO_PRIVATE_KEY=
# Canal que escucha el puente y en el que habla Vigía (Zello gratis: uno por conexión).
# Vacío = demo-platanus.
ZELLO_CHANNEL=
# Usuario de Zello del OBAC: lo que dice es una pregunta para Vigía. Vacío = solo cuenta
# lo que empieza con «Vigía, …».
ZELLO_OBAC_USERNAME=
# Opcional: wss://zello.io/ws (por defecto) o wss://zellowork.io/ws/<red> (Zello Work).
ZELLO_WS_URL=
# Token interno del puente (Authorization: Bearer). El mismo valor en el servidor y en
# el puente; genéralo con: openssl rand -hex 32. Obligatorio si hay DATABASE_URL; en modo
# local abierto puede quedar vacío.
VIGIA_BRIDGE_TOKEN=
# URL de Vigía a la que habla el puente (por defecto http://localhost:3000; o --url).
VIGIA_URL=
#
# ElevenLabs (las usa el puente): transcribe lo que llega por Zello (Speech-to-Text) y
# pone la voz de Vigía (TTS). Sin la llave, el puente solo escucha y las transmisiones
# quedan con su grabación y el texto «sin transcribir».
ELEVENLABS_API_KEY=
# Voz de Vigía (la configura Alessandro). Vacío = una voz de prueba de la biblioteca base.
ELEVENLABS_VOICE_ID=
# Opcionales: modelos de ElevenLabs (por defecto scribe_v1 y eleven_flash_v2_5).
VIGIA_STT_MODEL=
VIGIA_TTS_MODEL=

# ---------------------------------------------------------------------------
# Públicas (NEXT_PUBLIC_*)
# ---------------------------------------------------------------------------
# Las NEXT_PUBLIC_* que usa el navegador se fijan al construir (next build): en Docker
# y Cloud Build van como --build-arg; cambiarlas exige reconstruir la imagen.
#
# URL pública de la app, sin "/" final (enlaces y QR generados en el servidor).
# En producción debe ser la URL real del servicio y estar en el CORS del bucket.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Estilos de mapa MapLibre (por defecto OpenFreeMap, sin API key).
NEXT_PUBLIC_MAP_STYLE_DARK=
NEXT_PUBLIC_MAP_STYLE_LIGHT=
# Token público de Mapbox (pk.…) para la ficha /mando/[id]/ficha: estilo Standard 3D.
# Vacío = MapLibre con un estilo claro equivalente sobre OpenFreeMap.
NEXT_PUBLIC_MAPBOX_TOKEN=
